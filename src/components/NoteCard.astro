---
interface Props {
  href: string;
  title: string;
  description: string;
  tags: string[];
  publishDate: Date;
}

const { href, title, description, tags, publishDate } = Astro.props;

const formattedDate = publishDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<a
  href={href}
  class="glass-pane-strong group block rounded-2xl p-6 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-24px_rgba(30,111,217,0.45)] sm:p-7"
>
  <div class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-wider text-[var(--color-ink-faint)]">
    <time datetime={publishDate.toISOString()}>{formattedDate}</time>
    {
      tags.length > 0 && (
        <>
          <span class="h-1 w-1 rounded-full bg-[var(--color-accent-line)]" />
          <span class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="text-[var(--color-accent-soft)]">{tag}</span>
            ))}
          </span>
        </>
      )
    }
  </div>

  <h3 class="mt-3 font-sans text-xl font-semibold tracking-tight text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-accent)]">
    {title}
  </h3>

  <p class="mt-2.5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
    {description}
  </p>

  <span class="mt-5 inline-flex items-center gap-1.5 font-mono text-xs text-[var(--color-accent)]">
    read the dive
    <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
  </span>
</a>
