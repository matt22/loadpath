---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryTile from "../components/CategoryTile.astro";
import Facade from "../components/Facade.astro";
import { getCollection } from "astro:content";

const systemDesignNotes = await getCollection("system-design");
---

<BaseLayout
  title="loadpath — notes on why, not just how"
  description="Thought dives on system design: the nuanced calls, trade-offs, and boundaries behind how systems are actually built."
>
  <section class="relative overflow-hidden px-4 pb-16 pt-16 sm:px-6 sm:pt-24">
    <Facade
      class="pointer-events-none absolute inset-x-0 bottom-0 h-40 w-full opacity-70 sm:h-56"
      panes={40}
    />

    <div class="relative mx-auto max-w-3xl text-center">
      <div class="mullion-divider mx-auto mb-8 w-24"></div>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-accent)]">
        engineering thought dives
      </p>
      <h1
        class="mt-4 text-4xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-5xl"
      >
        Where the load actually goes.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-[var(--color-ink-soft)] sm:text-lg">
        Not "how to build X." Short, opinionated dives into the decisions
        underneath: when a boundary is load-bearing, when it's just
        decoration, and what breaks first when you get it wrong.
      </p>
    </div>
  </section>

  <section class="px-4 pb-24 sm:px-6">
    <div class="mx-auto grid max-w-5xl gap-4 sm:grid-cols-3">
      <CategoryTile
        href="/system-design"
        label="System Design"
        description="Boundaries, trade-offs, and the calls that only make sense with context."
        count={systemDesignNotes.length}
      />
      <CategoryTile
        href="/coding"
        label="Coding"
        description="Language- and pattern-level dives — idioms, pitfalls, and when to reach for them."
        disabled
      />
      <CategoryTile
        href="/lld"
        label="LLD"
        description="Low-level design — object boundaries, interfaces, and the shape of a class diagram."
        disabled
      />
    </div>
  </section>
</BaseLayout>
